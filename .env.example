# TEDER — Variáveis de Ambiente
# Copie para .env e preencha os valores

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/teder

# Redis
REDIS_URL=redis://localhost:6379/0

# Segurança
ADMIN_SECRET=troque-por-segredo-forte-aqui
SECRET_KEY=troque-por-chave-jwt-aqui

# Planos e limites (req/dia)
FREE_DAILY_LIMIT=100
DEVELOPER_DAILY_LIMIT=5000
BUSINESS_DAILY_LIMIT=50000

# Produto
TEDER_VERSION=0.1.0
ENVIRONMENT=development
